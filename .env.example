# pkg-knowledge-mcp environment variables
# Copy to .env and fill in values.

# Optional. Increases GitHub API rate limit from 60 -> 5000 req/hr.
# Create at https://github.com/settings/tokens (no scopes needed for public repos).
GITHUB_TOKEN=

# Max tokens to return per tool call (rough: 1 token ≈ 4 chars).
DEFAULT_MAX_TOKENS=4000

# httpx request timeout in seconds.
REQUEST_TIMEOUT=15
